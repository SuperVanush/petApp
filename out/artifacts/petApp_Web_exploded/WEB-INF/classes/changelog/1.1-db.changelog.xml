<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog

        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-2.0.xsd">

    <changeSet id="2" author="Natalya">
        <createTable tableName="transaction_history">
            <column name="transaction_id" type="BIGINT" autoIncrement="true">
                <constraints unique="true" nullable="false" primaryKey="true"/>
            </column>
            <column name="user_from_id" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="bill_from_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="sum_transaction" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_to_id" type="varchar (200)">
                <constraints nullable="false"/>
            </column>
            <column name="bill_to_id" type="varchar (200)">
                <constraints nullable="false"/>
            </column>
            <column name="time_date_transaction" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>
      </changeSet>


</databaseChangeLog>